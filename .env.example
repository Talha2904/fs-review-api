# FS Review api. Every setting is validated at start (src/config/env.ts); the process refuses to run
# with a missing or malformed value. Copy to .env and fill in.

# Required: development, test or production. Production also requires https in APP_URL and CORS_ORIGINS.
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Postgres connection string. Supabase: use the direct connection or the pooler in SESSION mode
# (transaction mode breaks Prisma's prepared statements). Moving to another host changes only this line.
DATABASE_URL=postgresql://fsreview:fsreview@localhost:5432/fsreview

# Optional. A second, migrated database for the integration tests under test/integration (they are skipped when
# this is blank). Local: docker exec api-postgres-1 psql -U fsreview -d fsreview -c "create database fsreview_test"
# then DATABASE_URL=postgresql://fsreview:fsreview@localhost:5432/fsreview_test npm run db:migrate
# DATABASE_URL_TEST=postgresql://fsreview:fsreview@localhost:5432/fsreview_test

# Browser origins allowed to call the api, comma separated. The Vite dev server is 5173. Writes from any other
# site are refused (CSRF protection).
CORS_ORIGINS=http://localhost:5173

# Which proxies to trust for the client address (rate limits, the activity log): loopback (default; a local
# proxy such as Vite), the number of proxies in front of the api (e.g. 1 behind one load balancer), or their
# addresses. Never more hops than there really are, or clients can forge their address. With
# docker-compose.prod.yml the web container's nginx is one hop: 1, or 2 with a TLS proxy (Caddy, nginx) in front.
# TRUST_PROXY=1

# Serve the API reference at /api/docs in production too (it is always served in development).
# DOCS_PUBLIC=false

# Address people use to open the app. Password reset links are built from this, never from the request.
APP_URL=http://localhost:5173

# Object storage, S3 protocol. Leave these blank to keep files on the api's disk (FILES_DIR below).
# Local MinIO from docker-compose: uncomment the five lines. Supabase Storage: its S3 endpoint and keys.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=fsreview
# S3_SECRET_KEY=fsreview-secret
# S3_FORCE_PATH_STYLE=true
S3_REGION=eu-west-1
S3_BUCKET=fs-review

# Live updates. "memory" for one api instance, "redis" for several.
EVENT_BUS=memory
# REDIS_URL=redis://localhost:6379

# Server-side only. Never prefix with VITE_.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Where Tesseract caches its language data (relative to the api folder).
OCR_CACHE_DIR=data/ocr-cache
# How many analyses run at once on this api instance (each reads documents and may call Claude).
ANALYSIS_WORKERS=2
# Uploaded files when no S3 settings are given (development and single-machine installs).
FILES_DIR=data/files

# Email (invoices, password reset). SMTP_HOST=test keeps mail in memory for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=accounts@yourfirm.com

# Billing: update the USD to GBP rate twice a day (1 = on); FX_URL overrides the rates service.
BILLING_FX_AUTO=0
FX_URL=

# Xero (optional; create an app at developer.xero.com; the redirect URI must be .../api/xero/callback)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
