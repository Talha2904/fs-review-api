{
  "name": "@fs-review/api",
  "version": "0.1.0",
  "private": true,
  "description": "FS Review backend: review workflow, identity, AI proxy, billing",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/interface/http/server.js",
  "scripts": {
    "dev": "tsx watch src/interface/http/server.ts",
    "build": "npm run build -w shared && tsc -p tsconfig.build.json",
    "start": "node dist/interface/http/server.js",
    "typecheck": "npm run typecheck -w shared && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"shared/**/*.ts\" \"docs/**/*.md\" BACKEND_PLAN.md",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"shared/**/*.ts\" \"docs/**/*.md\" BACKEND_PLAN.md",
    "test": "npm run test -w shared && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed-users.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "fixtures:analysis": "tsx scripts/make-analysis-fixtures.ts",
    "parity:analysis": "tsx scripts/analysis-parity.ts",
    "test:coverage": "npm run test -w shared && vitest run --coverage",
    "check:portability": "node scripts/check-portability.mjs",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@aws-sdk/client-s3": "3.901.0",
    "@aws-sdk/s3-request-presigner": "3.901.0",
    "@fs-review/shared": "*",
    "@prisma/client": "6.19.0",
    "@tesseract.js-data/eng": "1.0.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "nodemailer": "6.9.16",
    "pdfjs-dist": "3.11.174",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "tesseract.js": "5.1.1",
    "xlsx": "0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/multer": "2.0.0",
    "@types/node": "20.19.19",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "pdf-lib": "1.17.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vitest": "3.2.4"
  },
  "workspaces": [
    "shared"
  ],
  "optionalDependencies": {
    "canvas": "2.11.2"
  }
}
